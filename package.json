{
  "name": "developer-assessment-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/user-web & npm run dev --workspace=apps/admin-web & wait",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:user": "npm run dev --workspace=apps/user-web",
    "dev:admin": "npm run dev --workspace=apps/admin-web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/user-web && npm run build --workspace=apps/admin-web",
    "test": "npm run test --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=packages/database",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=packages/database"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
